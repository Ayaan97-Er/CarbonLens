# CarbonLens Environment Configuration

PROJECT_NAME=CarbonLens
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Default is SQLite for instant zero-configuration local execution.
# For PostgreSQL in production or local Docker, uncomment and customize:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carbonlens_db
DATABASE_URL=sqlite:///./carbonlens.db

# JWT Security
SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (Comma-separated origins or * for development)
CORS_ORIGINS=*

# Demo & Admin Seed Credentials (Local Development)
DEMO_USER_EMAIL=demo@carbonlens.dev
DEMO_USER_PASSWORD=CarbonLens2026!
DEMO_USER_NAME=Alex Morgan

ADMIN_USER_EMAIL=admin@carbonlens.dev
ADMIN_USER_PASSWORD=AdminCarbonLens2026!
ADMIN_USER_NAME=System Admin
